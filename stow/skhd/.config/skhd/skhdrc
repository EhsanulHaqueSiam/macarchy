alt + shift - a : ~/.local/bin/omarchy-mac-webapp https://chatgpt.com  # ChatGPT
alt + shift + cmd - a : ~/.local/bin/omarchy-mac-webapp https://grok.com  # Grok
alt + shift - c : ~/.local/bin/omarchy-mac-webapp https://app.hey.com/calendar/weeks/  # Calendar
alt + shift - e : ~/.local/bin/omarchy-mac-webapp https://app.hey.com  # Email
alt + shift + cmd - e : ~/.local/bin/omarchy-mac-webapp "https://app.hey.com/messages/new?display=standalone&new_window=true"  # New email
alt + shift - y : ~/.local/bin/omarchy-mac-webapp https://youtube.com/  # YouTube
alt + shift + cmd - g : ~/.local/bin/omarchy-mac-webapp https://web.whatsapp.com/  # WhatsApp
alt + shift + ctrl - g : ~/.local/bin/omarchy-mac-webapp https://messages.google.com/web/conversations  # Google Messages
alt + shift - p : ~/.local/bin/omarchy-mac-webapp https://photos.google.com/  # Google Photos
alt + shift - s : ~/.local/bin/omarchy-mac-webapp https://maps.google.com/  # Google Maps
alt + shift - x : ~/.local/bin/omarchy-mac-webapp https://x.com/  # X
alt + shift + cmd - x : ~/.local/bin/omarchy-mac-webapp https://x.com/compose/post  # X Post

# --- menus --------------------------------------------------------------
alt - space : /usr/bin/open -a Raycast  # Omarchy menu
alt + cmd - space : /usr/bin/open raycast://extensions/raycast/raycast/search-applications  # Apps menu
alt - escape : ~/.local/bin/omarchy-mac-menu  # System menu
alt - k : ~/.local/bin/omarchy-mac-keys  # Keybindings
alt + cmd - k : ~/.local/bin/omarchy-mac-run "tmux list-keys -N | less -R"  # Tmux keybindings
alt + ctrl - k : ~/.local/bin/omarchy-mac-run "herdr --help | less -R"  # Herdr keybindings
alt + ctrl - c : ~/.local/bin/omarchy-mac-capture  # Capture menu
alt + ctrl - o : /usr/bin/open x-apple.systempreferences:com.apple.ControlCenter-Settings.extension  # Toggle menu
alt + ctrl - h : /usr/bin/open -a "System Information"  # Hardware menu
alt + ctrl - e : ~/.local/bin/omarchy-mac-emoji  # Emojis
alt + ctrl - q : /usr/bin/open -a Calculator  # Calculator
alt + ctrl - s : /usr/bin/open -a AirDrop  # Share (AirDrop)

# --- panels -------------------------------------------------------------
alt + ctrl - a : /usr/bin/open x-apple.systempreferences:com.apple.Sound-Settings.extension  # Audio
alt + ctrl - b : /usr/bin/open x-apple.systempreferences:com.apple.BluetoothSettings  # Bluetooth
alt + ctrl - w : /usr/bin/open x-apple.systempreferences:com.apple.Network-Settings.extension  # Network
alt + ctrl - d : /usr/bin/open x-apple.systempreferences:com.apple.Displays-Settings.extension  # Display
alt + ctrl + cmd - d : /usr/bin/open -a Calendar  # Calendar
alt + ctrl - p : ~/.local/bin/omarchy-mac-session  # Power
alt + ctrl - t : ~/.local/bin/omarchy-mac-run btop  # Activity

# --- bar panels ---------------------------------------------------------
# Omarchy's SUPER+CTRL+<n> counts the panels in the bar's right section, left
# to right, so the number matches the icon you would point at.
