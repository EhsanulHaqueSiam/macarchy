# ~/.config/skhd/skhdrc - Omarchy on macOS: the LAUNCHER/UTILITY half.
#
#   alt (⌥) = Omarchy SUPER.   cmd (⌘) = Hyprland's ALT.   ctrl = CTRL.
#
# OWNERSHIP - this file and ~/.aerospace.toml are strictly disjoint:
#   AeroSpace  = native window/workspace commands (no process spawn).
#   skhd       = anything that runs a program, plus key synthesis (⌥C/⌥V/⌥X).
# Never bind a chord in both or it fires twice. `omarchy-mac-doctor` checks this.
#
# Ported 1:1 from ~/.local/share/omarchy/default/hypr/bindings/{applications,
# clipboard,utilities,media}.lua unless the trailing comment says otherwise.
# The `# comment` after each binding is its description in ⌥K.
#
# skhd hot-reloads this file on save (no .shell directive in 0.3.9).
# Symbol keys use raw macOS keycodes:
#   0x2B = comma   0x2F = period   0x2C = slash

# --- clipboard ----------------------------------------------------------
# Omarchy's universal copy/paste/cut. `skhd -k` synthesizes the chord through
# the same event tap in ~1ms; the old osascript keystroke took ~250ms and
# needed Accessibility. macOS terminals use cmd-c/v like everything else, so
# Omarchy's terminal CTRL+Insert special case has no analog here.
alt - c : /opt/homebrew/bin/skhd -k "cmd - c"  # Universal copy
alt - v : /opt/homebrew/bin/skhd -k "cmd - v"  # Universal paste
alt - x : /opt/homebrew/bin/skhd -k "cmd - x"  # Universal cut
alt + ctrl - v : /usr/bin/open raycast://extensions/raycast/clipboard-history/clipboard-history  # Clipboard manager

# --- applications -------------------------------------------------------
alt - return : /usr/bin/open -na Ghostty  # Terminal
alt + cmd - return : ~/.local/bin/omarchy-mac-tmux  # Tmux
alt + ctrl - return : ~/.local/bin/omarchy-mac-run herdr  # Herdr
alt + shift - return : /usr/bin/open -a Zen  # Browser
alt + shift - b : /usr/bin/open -a Zen  # Browser
alt + shift + cmd - b : /usr/bin/open -na Zen --args --private-window  # Browser (private)
alt + shift - f : /usr/bin/open ~  # File manager
alt + shift + cmd - f : /usr/bin/open .  # File manager (cwd)
alt + shift - n : ~/.local/bin/omarchy-mac-run nvim  # Editor
alt + shift - m : /usr/bin/open -a Music  # Music
alt + shift + cmd - m : ~/.local/bin/omarchy-mac-run "command -v cliamp >/dev/null && cliamp || open -a Music"  # Music TUI
alt + shift - d : ~/.local/bin/omarchy-mac-run lazydocker  # Docker
alt + shift - g : /usr/bin/open -a Signal  # Signal
alt + shift - o : /usr/bin/open -a Obsidian  # Obsidian
alt + shift - w : ~/.local/bin/omarchy-mac-note  # Omawrite (daily note)
alt + shift - 0x2C : /usr/bin/open -a Passwords  # Passwords
alt + shift + ctrl - a : ~/.local/bin/omarchy-mac-run "claude --permission-mode auto"  # Agent

