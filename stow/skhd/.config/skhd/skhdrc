alt + ctrl - 2 : /usr/bin/open x-apple.systempreferences:com.apple.Network-Settings.extension  # Bar panel 2 (network)
alt + ctrl - 3 : /usr/bin/open x-apple.systempreferences:com.apple.Sound-Settings.extension  # Bar panel 3 (audio)
alt + ctrl - 4 : /usr/bin/open x-apple.systempreferences:com.apple.Displays-Settings.extension  # Bar panel 4 (display)
alt + ctrl - 5 : ~/.local/bin/omarchy-mac-session  # Bar panel 5 (power)

# --- notifications ------------------------------------------------------
alt - 0x2B : ~/.local/bin/omarchy-mac-notify dismiss  # Dismiss last notification
alt + shift - 0x2B : ~/.local/bin/omarchy-mac-notify all  # Dismiss all notifications
alt + ctrl - 0x2B : /usr/bin/shortcuts run "Toggle Do Not Disturb"  # Toggle silencing notifications
alt + cmd - 0x2B : ~/.local/bin/omarchy-mac-notify invoke  # Invoke last notification
alt + shift + cmd - 0x2B : ~/.local/bin/omarchy-mac-notify history  # Notification history

# --- toggles ------------------------------------------------------------
alt + shift - space : ~/.config/sketchybar/plugins/bar-toggle.sh  # Toggle top bar
alt + shift - backspace : ~/.local/bin/omarchy-mac-gaps  # Toggle window gaps
alt + ctrl - space : ~/.local/bin/omarchy-mac-bg  # Background switcher
alt + shift + ctrl - space : ~/.local/bin/omarchy-mac-theme  # Theme menu
alt + ctrl - i : ~/.local/bin/omarchy-mac-idle; /opt/homebrew/bin/sketchybar --trigger indicators_refresh  # Toggle locking on idle
alt + ctrl - n : ~/.local/bin/omarchy-mac-nightlight; /opt/homebrew/bin/sketchybar --trigger indicators_refresh  # Toggle nightlight
alt + ctrl - l : ~/.local/bin/omarchy-mac-lock  # Lock system
alt - home : ~/.local/bin/omarchy-mac-width restore  # Restore window width
alt + cmd - home : ~/.local/bin/omarchy-mac-width save  # Save window width
alt - 0x2C : ~/.local/bin/omarchy-mac-scale up  # Monitor scaling up
alt + cmd - 0x2C : ~/.local/bin/omarchy-mac-scale down  # Monitor scaling down
alt + ctrl - 0x2F : ~/.local/bin/omarchy-mac-transcode  # Transcode
alt + ctrl - z : ~/.local/bin/omarchy-mac-zoom in  # Zoom in
alt + ctrl + cmd - z : ~/.local/bin/omarchy-mac-zoom reset  # Reset zoom

# --- reminders and toasts -----------------------------------------------
alt + ctrl - r : /usr/bin/open -a Reminders  # Set reminder
alt + ctrl + cmd - r : /usr/bin/open -a Reminders  # Show reminders
alt + shift + ctrl - r : /usr/bin/open -a Reminders  # Clear reminders
alt + ctrl + cmd - t : ~/.local/bin/omarchy-mac-info time  # Show time
alt + ctrl + cmd - b : ~/.local/bin/omarchy-mac-info power  # Show battery remaining
alt + ctrl + cmd - w : ~/.local/bin/omarchy-mac-info weather  # Toggle weather

# --- capture (F13 sits where PrintScreen does on a full-size Apple keyboard) --
f13 : ~/.local/bin/omarchy-mac-screenshot  # Screenshot
cmd - f13 : /usr/bin/open -a Screenshot  # Screenrecording
alt - f13 : /usr/bin/open -a "Digital Color Meter"  # Color picker
alt + ctrl - f13 : /usr/bin/shortcuts run "OCR Screenshot"  # Extract text (OCR) from screenshot

# --- media --------------------------------------------------------------
shift - mute : /opt/homebrew/bin/SwitchAudioSource -n  # Switch audio output

# --- macOS extras (no Omarchy equivalent) -------------------------------
# The macOS menu bar is hidden for the bar, so this is how you reach an app's
# File/Edit/View menus from the keyboard: Raycast searches every menu item of
# the focused app. macOS's own Help-menu search (⌘⇧/) also still works.
alt + cmd - m : ~/.local/bin/omarchy-mac-menu-bar  # App menu bar (File/Edit/View...)
alt + ctrl - x : ~/.local/bin/omarchy-mac-mission-control  # Mission Control
alt + ctrl + cmd - s : /usr/bin/open -a "Screen Sharing"  # Screen Sharing
alt + shift + ctrl - o : /opt/homebrew/bin/SwitchAudioSource -n  # Next audio output
alt + shift + cmd - 0x2C : /usr/bin/open x-apple.systempreferences:com.apple.Keyboard-Settings.extension  # Keyboard settings

# --- swallowing a macOS chord -------------------------------------------
# skhd's event tap sits ahead of the system, so binding a chord to /bin/true
# consumes it and macOS never sees it. Use this if a macOS default ever fights
# an Omarchy binding, e.g. to kill Cmd+H (hide window):
#   cmd - h : /bin/true

# --- Omarchy's ALT+TAB --------------------------------------------------
# Omarchy cycles WINDOWS with ALT+TAB. With the Win=SUPER swap in place the
# physical Alt key sends Cmd, so binding cmd-tab puts window cycling exactly
# where Omarchy has it. skhd's event tap sits ahead of the system, so this
# genuinely takes Cmd+Tab away from the macOS app switcher - verified: focus
# cycled 602 -> 594 -> 602 across two windows. Reach other workspaces with
# ⌥Tab / ⌥1-0, and apps with ⌥Space, the way Omarchy does.
# Comment both lines out to hand Cmd+Tab back to macOS.
cmd - tab : /opt/homebrew/bin/aerospace focus --boundaries-action wrap-around-the-workspace dfs-next
cmd + shift - tab : /opt/homebrew/bin/aerospace focus --boundaries-action wrap-around-the-workspace dfs-prev
