#!/bin/bash
d="$HOME/.config/omarchy-mac/themes"
list=$(ls -1 "$d" 2>/dev/null | sed 's/\.[^.]*$//' | paste -sd, - | sed 's/[^,]*/"&"/g')
[ -z "$list" ] && list='"last-horizon"'
c=$(osascript -e "choose from list {$list} with title \"Theme\"" 2>/dev/null)
[ "$c" = "false" ] || [ -z "$c" ] && exit 0
exec "$HOME/.local/bin/omarchy-mac-colors" "$c"
