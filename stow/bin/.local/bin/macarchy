#!/usr/bin/env bash
# macarchy - one entry point for humans and coding agents.
# Run `macarchy help` for the list. Agents: read AGENTS.md in the repo first.
set -uo pipefail
export PATH="$HOME/.local/bin:/opt/homebrew/bin:/opt/homebrew/sbin:$PATH"
REPO="${MACARCHY_REPO:-$HOME/macarchy}"
PKGS="aerospace skhd sketchybar borders bin zsh autoraise ghostty"

usage(){ cat <<'USAGE'
macarchy <command>

  doctor         health check: services, both configs, disjointness, macOS settings
  verify         run the functional regression suite (exits non-zero on failure)
  verify --windows   ...plus live window checks on throwaway windows (~20s, needs an unlocked screen)
  keys           the keybinding cheat sheet, generated from the live configs
  bindings       every binding from both configs, as TSV (add --json for JSON)
  where          print the repo path

  link | relink | unlink    GNU stow the configs into $HOME
  reload         restart aerospace, skhd, sketchybar, borders, autoraise
  colors         rebuild bar + border colours from the active Omarchy theme
  docs           capture screenshots + demo gif (must run ON the Mac, not over ssh)

Ownership rule: ~/.aerospace.toml holds only native AeroSpace commands,
~/.config/skhd/skhdrc holds anything that runs a program. A chord in both
fires twice; `macarchy doctor` fails if they intersect.
USAGE
}

# Both configs, normalised to: tool <TAB> chord <TAB> action
dump_bindings(){
  /usr/bin/python3 - "$HOME/.aerospace.toml" "$HOME/.config/skhd/skhdrc" "${1:-tsv}" <<'PYEOF'
import json, re, sys
aero, skhd, fmt = sys.argv[1], sys.argv[2], sys.argv[3]
rows, table = [], None
for line in open(aero):
    s = line.strip()
    if s.startswith("[") and s.endswith("]"):
        table = s; continue
    if table != "[mode.main.binding]":
        continue
    m = re.match(r"^([a-z0-9-]+)\s*=\s*'([^']*)'\s*(?:#\s*(.*))?$", s)
    if m:
        rows.append({"tool": "aerospace", "chord": m.group(1),
                     "action": m.group(2), "desc": (m.group(3) or "").strip()})
block = None
for line in open(skhd):
    s = line.rstrip("\n")
    # Per-app blocks: `chord [` ... `* : cmd  # desc` ... `]`. Read the `*` line as the chord.
    if s.strip().endswith("["):
        block = s.strip()[:-1].strip(); continue
    if s.strip() == "]":
        block = None; continue
    if block and s.strip().startswith("*"):
        s = block + s.strip()[1:]
    if s.strip().startswith(("#", ".")) or ":" not in s:
        continue
    body, _, desc = s.partition("#")
    lhs, _, cmd = body.partition(":")
    if not lhs.strip() or not cmd.strip():
        continue
    rows.append({"tool": "skhd", "chord": lhs.strip(),
                 "action": cmd.strip(), "desc": desc.strip()})
if fmt == "json":
    print(json.dumps(rows, indent=2))
else:
    for r in rows:
        print("%s\t%s\t%s" % (r["tool"], r["chord"], r["desc"] or r["action"]))
PYEOF
}

# Real regression suite. Uses an empty workspace and restores what it touches.
verify(){
  local pass=0 fail=0
  chk(){ if [ "$2" = "$3" ]; then echo "  PASS  $1"; pass=$((pass+1));
         else echo "  FAIL  $1  got[$2] want[$3]"; fail=$((fail+1)); fi; }

  echo "health:"
  omarchy-mac-doctor >/dev/null 2>&1 && echo "  PASS  doctor" && pass=$((pass+1)) \
    || { echo "  FAIL  doctor (run: macarchy doctor)"; fail=$((fail+1)); }

  echo "configs:"
  chk "aerospace parses" "$(aerospace reload-config 2>&1 | /usr/bin/grep -c ERROR)" "0"
  chk "aerospace bindings registered" \
      "$([ "$(aerospace config --get mode.main.binding --json | jq -r 'keys|length')" -gt 50 ] && echo many || echo few)" "many"
  # grep -c prints 0 AND exits 1 on no match, so `|| echo 0` would append a
  # second zero and this could never pass.
  local serr; serr=$(/usr/bin/grep -ci error "/tmp/skhd_$USER.err.log" 2>/dev/null); serr=${serr:-0}
  chk "skhd config clean" "$serr" "0"

  echo "binding targets:"
  # A chord whose app or helper is gone does nothing at all, silently.
  local miss="" a
  while read -r a; do /usr/bin/open -Ra "$a" 2>/dev/null || miss="$miss app:$a"; done < <(
    /usr/bin/grep -oE 'open -n?a ("[^"]+"|[A-Za-z]+)' "$HOME/.config/skhd/skhdrc" |
    sed -E 's/^open -n?a //; s/"//g' | sort -u)
  while read -r a; do [ -x "$HOME/.local/bin/$a" ] || miss="$miss bin:$a"; done < <(
    /usr/bin/grep -oE '~/\.local/bin/[A-Za-z0-9-]+' "$HOME/.config/skhd/skhdrc" | sed 's|.*/||' | sort -u)
  chk "every app and helper a binding calls exists" "${miss# }" ""

  echo "bar:"
  chk "sketchybar running" "$(pgrep -x sketchybar >/dev/null && echo y || echo n)" "y"
  chk "bar visible" "$(sketchybar --query bar | jq -r .hidden)" "off"

  echo "window management:"
  local start; start=$(aerospace list-workspaces --focused)
  for w in 3 5; do
    aerospace trigger-binding "alt-$w" --mode main 2>/dev/null; sleep 0.9
    chk "alt-$w switches + lights its pill" \
        "$(aerospace list-workspaces --focused)/$(sketchybar --query "space.$w" | jq -rc '.label.value')" "$w/󱓻"
  done
  aerospace workspace "$start" >/dev/null 2>&1

  if [ "${1:-}" = "--windows" ]; then
    echo "live windows:"
    if [ "$(ioreg -n Root -d1 -a | plutil -extract IOConsoleUsers.0.CGSSessionScreenIsLocked raw -o - - 2>/dev/null)" = true ]; then
      echo "  SKIP  screen is locked: AeroSpace cannot see windows until unlock"
    else
      verify_windows
    fi
  fi

  echo
  echo "$pass passed, $fail failed"
  [ "$fail" -eq 0 ]
}

# Window frame "x y w h" by AeroSpace window id (= CoreGraphics window number).
# CoreGraphics works over ssh; the accessibility API returns no windows there.
frame(){ osascript -l JavaScript -e 'ObjC.import("CoreGraphics");
  function run(a){ const l = ObjC.castRefToObject($.CGWindowListCopyWindowInfo(8 /* kCGWindowListOptionIncludingWindow */, +a[0]));
    if (!l.count) return ""; const b = l.objectAtIndex(0).objectForKey("kCGWindowBounds");
    return ["X","Y","Width","Height"].map(k => Math.round(b.objectForKey(k).js)).join(" "); }' "$1"; }

# `verify --windows`: drives the real bindings against three throwaway TextEdit
# windows on an empty workspace, then puts everything back. Takes the screen for
# ~20s. Uses verify's chk/pass/fail (bash locals are dynamically scoped).
verify_windows(){
  local start ws="" tgt="" dir ids w w0 f0 hs clip
  start=$(aerospace list-workspaces --focused)
  for w in 9 8 7 6; do
    [ -n "$(aerospace list-windows --workspace $w)" ] && continue
    if [ -z "$ws" ]; then ws=$w; else tgt=$w; break; fi
  done
  [ -z "$tgt" ] && { echo "  SKIP  needs two empty workspaces among 6-9"; return; }
  bind(){ aerospace trigger-binding "$1" --mode main; sleep 0.4; }
  fw(){ aerospace list-windows --focused --format '%{window-id}' 2>/dev/null; }
  changed(){ [ "$1" != "$2" ] && echo yes || echo "no ($1)"; }

  dir=$(mktemp -d); printf 'macarchy-clip-test' > "$dir/a.txt"; printf b > "$dir/b.txt"; printf c > "$dir/c.txt"
  aerospace workspace "$ws"
  for f in a b c; do open -a TextEdit "$dir/$f.txt"; sleep 0.8; done
  for _ in 1 2 3 4 5 6; do [ "$(aerospace list-windows --workspace "$ws" --count)" -ge 3 ] && break; sleep 0.5; done
  ids=$(aerospace list-windows --workspace "$ws" --format '%{window-id}')
  chk "3 new windows tile on $ws" "$(echo "$ids" | grep -c .)" "3"
  # Dwindle: one full-height window beside two stacked halves.
  hs=$(for w in $ids; do frame "$w" | cut -d' ' -f4; done | sort -n | tr '\n' ' ')
  chk "dwindle: one full-height, two stacked" \
      "$(echo $hs | awk '{print (NF==3 && $2-$1<=2 && $3>2*$1-30) ? "yes" : "no (" $0 ")"}')" "yes"

  w0=$(fw); bind alt-left
  chk "⌥← moves focus" "$(changed "$(fw)" "$w0")" "yes"
  bind alt-right; chk "⌥→ moves it back" "$(fw)" "$w0"
  f0=$(frame "$w0"); bind alt-shift-left
  chk "⌥⇧← swaps the window" "$(changed "$(frame "$w0")" "$f0")" "yes"; bind alt-shift-right
  f0=$(frame "$w0"); bind alt-j
  chk "⌥J flips the split" "$(changed "$(frame "$w0")" "$f0")" "yes"; bind alt-j
  f0=$(frame "$w0"); bind alt-minus
  chk "⌥- resizes" "$(changed "$(frame "$w0")" "$f0")" "yes"; bind alt-b
  bind alt-t; chk "⌥T floats" "$(aerospace list-windows --focused --format '%{window-layout}')" "floating"; bind alt-t
  bind alt-f; chk "⌥F fullscreens" "$(aerospace list-windows --focused --format '%{window-is-fullscreen}')" "true"; bind alt-f
  bind "alt-shift-cmd-$tgt"
  chk "⌥⇧⌘$tgt moves it silently" "$(aerospace list-windows --workspace "$tgt" --format '%{window-id}')/$(aerospace list-workspaces --focused)" "$w0/$ws"
  aerospace move-node-to-workspace --window-id "$w0" "$ws"; aerospace focus --window-id "$w0"; sleep 0.3
  bind alt-shift-backtick; chk "⌥⇧\` stashes it in the scratchpad" "$(aerospace list-windows --workspace S --format '%{window-id}')" "$w0"
  bind alt-backtick; chk "⌥\` shows the scratchpad" "$(aerospace list-workspaces --focused)" "S"
  bind alt-backtick; chk "⌥\` hides it again" "$(aerospace list-workspaces --focused)" "$ws"
  aerospace move-node-to-workspace --window-id "$w0" "$ws"

  # Universal copy through skhd's synthesized ⌘ chords. Skipped when the
  # clipboard holds anything but text, since it is overwritten and restored.
  if osascript -e 'clipboard info' 2>/dev/null | grep -qE "PNG|TIFF|furl|PDF"; then
    echo "  SKIP  ⌥A ⌥C (clipboard holds non-text)"
  else
    clip=$(pbpaste)
    aerospace focus --window-id "$(aerospace list-windows --workspace "$ws" --format '%{window-id}|%{window-title}' | grep a.txt | cut -d'|' -f1)"; sleep 0.4
    skhd -k "alt - a"; sleep 0.2; skhd -k "alt - c"; sleep 0.4
    chk "⌥A ⌥C copy the document" "$(pbpaste)" "macarchy-clip-test"
    printf %s "$clip" | pbcopy
  fi

  for w in $(aerospace list-windows --workspace "$ws" --format '%{window-id}'); do
    aerospace close --window-id "$w" --quit-if-last-window; sleep 0.3
  done
  rm -rf "$dir"; aerospace workspace "$start"
}

case "${1:-help}" in
  doctor)   omarchy-mac-doctor ;;
  verify)   verify "${2:-}" ;;
  keys)     omarchy-mac-keys-gen ;;
  bindings) [ "${2:-}" = "--json" ] && dump_bindings json || dump_bindings tsv ;;
  where)    echo "$REPO" ;;
  link)     (cd "$REPO" && stow $PKGS)    && echo "linked" ;;
  relink)   (cd "$REPO" && stow -R $PKGS) && echo "relinked" ;;
  unlink)   (cd "$REPO" && stow -D $PKGS) && echo "unlinked" ;;
  colors)   omarchy-mac-colors ;;
  docs)     "$REPO/scripts/capture-docs.sh" ;;
  reload)   aerospace reload-config || true
            skhd --restart-service || true
            sketchybar --reload || true
            brew services restart borders >/dev/null 2>&1 || true
            brew services restart autoraise >/dev/null 2>&1 || true
            echo "reloaded" ;;
  help|-h|--help) usage ;;
  *) echo "unknown command: $1" >&2; echo; usage; exit 2 ;;
esac
