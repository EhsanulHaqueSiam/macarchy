#!/bin/bash
# Regenerate SketchyBar + borders colours from the active Omarchy theme.
# Run by omarchy-mac-set-theme; safe to run by hand after editing a theme.
C="$HOME/.local/state/omarchy/current/theme/colors.toml"
[ -f "$C" ] || { echo "no active theme at $C" >&2; exit 0; }

get(){ /usr/bin/grep -m1 "^$1 *=" "$C" | sed -E 's/.*"#?([0-9a-fA-F]{6})".*/\1/'; }
# Hyprland writes borders as rgba(RRGGBBAA); JankyBorders wants 0xAARRGGBB.
hypr(){ /usr/bin/grep -m1 "^$1 *=" "$C" \
  | sed -E 's/.*= *"(.*)"/\1/; s/rgba\(([0-9a-fA-F]{6})([0-9a-fA-F]{2})\)/0x\2\1/g'; }

BG=$(get background); FG=$(get foreground); MUTED=$(get muted)
ACCENT=$(get accent);  RED=$(get red)

mkdir -p "$HOME/.config/omarchy-mac"
cat > "$HOME/.config/omarchy-mac/colors.sh" <<EOC
# Generated by omarchy-mac-colors from the active theme. Do not edit.
export BAR_BG=0xff${BG:-0c0b0c}
export BAR_FG=0xff${FG:-FAFCFB}
export BAR_MUTED=0xff${MUTED:-584e51}
export BAR_ACCENT=0xff${ACCENT:-b59790}
export BAR_RED=0xff${RED:-c38b7b}
EOC

# looknfeel.lua: border_size = 2 with a grey two-stop gradient. That reads on
# Hyprland but vanishes on macOS (2pt of grey next to a dark window), so the
# focused window gets the theme's bright foreground, solid, at 6pt. Inactive
# keeps the theme's translucent grey.
#
# style=round, NOT square, even though Omarchy sets rounding = 0. Hyprland's
# rounding squares the WINDOW, so a square border fits it exactly. AppKit
# rounds every macOS window at the OS level and nothing can turn that off, so
# a square border overshoots each rounded corner and fills the gap with a
# thick blob. round is the only style that hugs the real window shape.
BRIGHT=$(get bright_foreground)
ACTIVE=0xff${BRIGHT:-${FG:-FAFCFB}}
INACT=$(hypr hyprland_inactive_border); INACT=${INACT:-0xaa584e51}

# A retina display needs hidpi=on or the 2pt border renders thin and soft.
# Detected rather than assumed, so the same config works on any screen.
HIDPI=off
system_profiler SPDisplaysDataType 2>/dev/null | /usr/bin/grep -qi retina && HIDPI=on

mkdir -p "$HOME/.config/borders"
cat > "$HOME/.config/borders/bordersrc" <<EOB
#!/bin/bash
# Generated by omarchy-mac-colors. JankyBorders execs this when \`borders\` is
# started with no arguments, so it MUST end by invoking borders with options.
options=(
  style=round
  width=6.0
  hidpi=$HIDPI
  active_color=$ACTIVE
  inactive_color=$INACT
)
borders "\${options[@]}"
EOB
chmod +x "$HOME/.config/borders/bordersrc"

# Restart through brew services so launchd keeps owning the process; the old
# pkill + detached-background start left an orphan brew could not manage.
/opt/homebrew/bin/brew services restart borders >/dev/null 2>&1 \
  || { pkill -x borders; (/opt/homebrew/opt/borders/bin/borders >/dev/null 2>&1 &); }
/opt/homebrew/bin/sketchybar --reload >/dev/null 2>&1 || true
