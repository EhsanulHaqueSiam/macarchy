#!/bin/bash
# SUPER+CTRL+SPACE: cycle the active theme's wallpapers.
D="$HOME/.config/omarchy-mac/backgrounds"; STATE="$HOME/.config/omarchy-mac/bg.index"
set -- "$D"/*.png; [ -e "$1" ] || exit 0
n=$#; i=$(cat "$STATE" 2>/dev/null || echo 0); i=$(( (i + 1) % n ))
echo "$i" > "$STATE"; shift "$i"; f=$1
osascript -e "tell application \"System Events\" to tell every desktop to set picture to \"$f\""
